# Chat API (Sales Agent). Used for POST /api/chat.
VITE_CHAT_API_BASE_URL=https://getagent-chat-agent.ceilu9.easypanel.host

# Chat Stream API (SSE). Used for POST /api/chat/stream.
VITE_CHAT_STREAM_API_URL=https://getagent-chat-agent.ceilu9.easypanel.host/api/chat/stream

# Objects API. Used for POST to fetch product details by FCA IDs (product grid).
VITE_OBJECTS_API_URL=https://getbutik-base-getbutik-db-service.ceilu9.easypanel.host/api/chat_bot/objects

# Base URL for product images (used when image_url from API is relative).
VITE_IMAGE_BASE_URL=https://getbutik-base-getbutik-db-service.ceilu9.easypanel.host

# ImgBB image upload (used when attaching images from camera/gallery).
VITE_IMGBB_API_KEY=""

# Optional: POST JSON { "email": "..." } when user subscribes from the newsletter flow.
# If unset, subscribe succeeds locally after a short delay (no network).
VITE_NEWSLETTER_API_URL=

# Logto (magic link → /auth/magic-link → /callback → ID claims saved to localStorage).
VITE_LOGTO_ENDPOINT=
VITE_LOGTO_APP_ID=
# Full URL emailed in magic link; default is http://localhost:5173/auth/magic-link
# VITE_LOGTO_MAGIC_LINK_REDIRECT_URL=

# Calendar / email agent (grouped events, create event). Default matches prior `config.apiBaseUrl`.
# VITE_CALENDAR_API_BASE_URL=
